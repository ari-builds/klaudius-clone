{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "app/**", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/([^/]+)(/.*)?", "dest": "/api/$1.js" },
    { "src": "/site/([^/]+)", "dest": "/api/site.js?slug=$1" },
    { "src": "/api/freebuild", "dest": "/api/freebuild.js" },
    { "src": "/app/(.*)", "dest": "/app/$1" },
    { "src": "/(favicon.ico|manifest.json|sw.js)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/app/index.html" }
  ]
}
